NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# Optional absolute directory containing the built SPA. Keep public indexing off in dev and staging.
FRONTEND_DIST_DIR=
PUBLIC_INDEXING_ENABLED=false

POSTGRES_DB=zahraoui_cover
POSTGRES_USER=zahraoui_cover
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=

# Generate three distinct 32-byte hex secrets.
RATE_KEY_SECRET=
CSRF_SECRET=
RESET_JOB_KEY=

# Use loopback Mailpit in development. Production requires tls or starttls for outbound email.
SMTP_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=zahraoui-cover@example.invalid
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Enable intake with an approved privacy notice version, text, and a distinct 32-byte hex secret.
PRIVACY_NOTICE_VERSION=
QUOTE_NOTICE_TEXT=
IDEMPOTENCY_KEY_SECRET=
QUOTE_ACK_EMAIL=false
INTAKE_NOTIFY_EMAIL=

# Enable each support form with its own approved wording under the shared notice version.
CONTACT_NOTICE_TEXT=
ASSISTANCE_NOTICE_TEXT=
CONTACT_ACK_EMAIL=false

# Absolute private directory outside the workspace and any web root. Required for local quote PDFs.
QUOTE_PDF_DIR=

# B9 internal renewal alerts. Leave recipient blank to keep delivery disabled.
RENEWAL_NOTIFY_EMAIL=
RENEWAL_REMINDER_DAYS=30,15,7,1
