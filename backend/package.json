{
  "name": "zahraoui-cover-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx src/modules/auth/create-admin.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/src/worker.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 tests/*.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
